__pycache__/
.DS_Store
*.pyc
.pytest_cache/
.venv/
*.egg-info/
.env

# Each Run's working directory, holding the Notification it was handed. Not a commit.
runs/

# The presenter's corporate CA, for a build on a laptop behind an intercepting
# proxy, goes here and is never committed. The one committed file is the empty
# placeholder the build argument defaults to (ticket 02 of hardened-demo-image).
certs/*
!certs/NO_EXTRA_CERTS

# Subagent worktrees. Ephemeral; never a commit.
.claude/worktrees/
