# Copy to .env, fill in, and never commit it. Compose hands this file to the demo
# service; .env is ignored by git and kept out of the build context, so no
# credential is ever baked into the image. It is the demo's one configuration:
# the laptop helpers (the reset, the replay, the end-to-end check) read this same
# file, and never your shell's own jira-as settings.
#
#     cp .env.example .env

# The real Jira credential. In the container it lives in the Receiver's process
# and the Forwarder it owns, and nothing else: a Run's environment gets a per-Run
# sentinel in place of the token (ADR 0002). On the laptop, the reset and the
# end-to-end check hand the same three to jira-as.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.invalid
JIRA_API_TOKEN=paste-your-atlassian-api-token-here

# What a Run authenticates with. This is the one credential a Run really holds,
# and nothing documented can mask it. The demo says so out loud.
CLAUDE_CODE_OAUTH_TOKEN=paste-your-claude-code-oauth-token-here

# The key of the Jira Service Management project the demo writes to, one a Jira
# admin created for it. There is deliberately no default: the Receiver refuses
# to start until this names your project. Runs, the reset and the end-to-end
# check may name this project and no other.
DEMO_PROJECT_KEY=

# The project's own custom field ids (customfield_<n>) and its Incidents queue.
# `python3 -m grafana_jsm_sandbox.configure` is to read them off the project and
# write them here; until it exists, `jira-as -o json api call getFields` lists
# them. The Receiver checks their shape and renders the field ids into the Run's
# Skill at every start. An empty field id means the project lacks the field, and a
# Run leaves it off.
DEMO_SEVERITY_FIELD=
DEMO_URGENCY_FIELD=
DEMO_SOURCE_FIELD=
DEMO_MAJOR_INCIDENT_FIELD=
DEMO_QUEUE_URL=

# Where compose publishes Grafana and the Receiver on this laptop, when 3000 or
# 8080 is taken. The replay script follows them too. Uncomment to override.
# BIND_ADDRESS=127.0.0.1
# GRAFANA_HOST_PORT=3000
# RECEIVER_HOST_PORT=8080

# Everything below has a working default, and the image already sets the two
# directories. Uncomment to override.
# RECEIVER_HOST=0.0.0.0
# RECEIVER_PORT=8080
# RUNS_DIRECTORY=/app/runs
# SKILL_DIRECTORY=/app/skill
# RUN_TIMEOUT=300
